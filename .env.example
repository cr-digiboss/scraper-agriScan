DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Synchronisation Qdrant (assistant IA AgriBot) — optionnel : si absent,
# l'indexation est simplement ignorée et le scraping continue normalement.
QDRANT_URL=https://xxxx.qdrant.io
QDRANT_API_KEY=
QDRANT_COLLECTION=agriscan_machines
MISTRAL_API_KEY=
